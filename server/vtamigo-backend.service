[Unit]
Description=VTAmigo backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vtamigo
Environment=HOME=/home/vtamigo
WorkingDirectory=/opt/vtamigo/backend
EnvironmentFile=/etc/vtamigo.env
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5
MemoryMax=800M

[Install]
WantedBy=multi-user.target
