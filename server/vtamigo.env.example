# Copy to /etc/vtamigo.env (chmod 600) and fill in the values you need.
# Only set the provider(s) you actually plan to use on this box.

# --- AI provider CLIs (leave unset if the CLI isn't installed on this host) ---
# CLAUDE_PATH=/usr/local/bin/claude
# GROK_PATH=/usr/local/bin/grok
# AGY_PATH=/usr/local/bin/agy

# --- ChatGPT (OpenAI API) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- ElevenLabs TTS ---
# ELEVENLABS_API_KEY=

# --- Piper TTS (paths default to backend/piper on Linux, see setup.sh) ---
# PIPER_DIR=/opt/vtamigo/backend/piper
# One of the 18 voices installed by setup.sh from AIHeaven/piper_unofficial_voices/es —
# run `ls backend/piper/voices` on the VPS to see all options.
# PIPER_DEFAULT_VOICE=es_MX-alan-medium.onnx

# --- Auth: Twitch OAuth login + allowlist admin panel ---
# Create an app at https://dev.twitch.tv/console/apps — register a redirect
# URI matching TWITCH_REDIRECT_URI exactly (e.g. https://YOURDOMAIN/auth/twitch/callback,
# or http://localhost:3001/auth/twitch/callback for local dev).
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=https://YOURDOMAIN/auth/twitch/callback
# Long random string used to sign session cookies (both user + admin sessions).
# SESSION_SECRET=
# Password for the separate /admin approval panel (not a Twitch account).
# ADMIN_PASSWORD=

PORT=3001
