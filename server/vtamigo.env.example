# Copy to /etc/vtamigo.env (chmod 600) and fill in the values you need.
# Only set the provider(s) you actually plan to use on this box.

# --- Environment (selects which SQLite DB file the backend reads/writes:
# backend/data/db/vtamigo.<env>.sqlite3, see backend/db.js). The systemd unit
# already sets APP_ENV=production directly; override here only if you're
# running a second environment (e.g. staging) off the same box/env file.
# APP_ENV=production

# --- AI provider CLIs (leave unset if the CLI isn't installed on this host) ---
# CLAUDE_PATH=/usr/local/bin/claude
# GROK_PATH=/usr/local/bin/grok
# AGY_PATH=/usr/local/bin/agy

# --- ChatGPT (OpenAI API) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- Piper TTS (paths default to backend/piper on Linux, see setup.sh) ---
# PIPER_DIR=/opt/vtamigo/backend/piper
# One of the 18 voices installed by setup.sh from AIHeaven/piper_unofficial_voices/es —
# run `ls backend/piper/voices` on the VPS to see all options.
# PIPER_DEFAULT_VOICE=es_MX-alan-medium.onnx

# --- Auth: Twitch OAuth login + allowlist admin panel ---
# Create an app at https://dev.twitch.tv/console/apps — register a redirect
# URI matching TWITCH_REDIRECT_URI exactly (e.g. https://YOURDOMAIN/auth/twitch/callback,
# or http://localhost:3001/auth/twitch/callback for local dev).
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=https://YOURDOMAIN/auth/twitch/callback
# Also register this second redirect URI on the same Twitch app — used by
# Settings > "Connect my own bot account" (a streamer links their own bot's
# Twitch account for chat:edit, instead of using the site-wide fallback bot).
# TWITCH_BOT_REDIRECT_URI=https://YOURDOMAIN/auth/twitch/bot-callback
# Long random string used to sign session cookies (both user + admin sessions).
# SESSION_SECRET=
# Password for the separate /admin approval panel (not a Twitch account).
# ADMIN_PASSWORD=

# --- YouTube Data API v3 (song-request queue: title search + default playlist) ---
# Create a key at https://console.cloud.google.com/apis/credentials with the
# YouTube Data API v3 enabled. Not needed for direct URL/video-ID requests —
# those resolve via the free oEmbed endpoint.
# YOUTUBE_API_KEY=

# --- Site-wide fallback bot account ---
# Used to send chat messages for users who haven't configured their own bot
# account in Settings. Generate an OAuth chat token at https://twitchapps.com/tmi
# for whichever Twitch account you want to act as the shared bot.
# TWITCH_SITE_BOT_USERNAME=
# TWITCH_SITE_BOT_TOKEN=

PORT=3001
